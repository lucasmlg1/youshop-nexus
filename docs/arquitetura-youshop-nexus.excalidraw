    {
      "id": "p_loop_t",
      "type": "text",
      "x": 56,
      "y": 740,
      "width": 538,
      "height": 22,
      "angle": 0,
      "strokeColor": "#0e234a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
